# Copy this file to .env in the same folder. Every name is optional.
# The API reads them with the AP_ prefix. See app/core/config.py.

# local | test | production
AP_ENV=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
AP_LOG_LEVEL=INFO
# text is one readable line. json is one object per line (useful in Docker).
AP_LOG_FORMAT=text

# Where uploads, the case list, and intake status are stored.
# AP_DATA_DIR=

# Browser origins allowed to call the API directly.
AP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AP_MAX_FILES=20
AP_MAX_FILE_BYTES=20971520

# A clean match at or above the first line auto-clears.
# From the second line up to that point, the case is flagged for a person.
# Below the second line it is rejected.
AP_AUTO_CLEAR_CONFIDENCE=0.95
AP_FLAG_CONFIDENCE=0.70

AP_OLLAMA_BASE_URL=http://127.0.0.1:11434
AP_OLLAMA_MODEL=llama3.2
# How many chat calls may run at once. Further documents wait.
AP_OLLAMA_MAX_IN_FLIGHT=2
# A longer receipt is split into page groups of about this many characters.
AP_MODEL_MAX_CHARS=24000
# Documents are read in parallel. Model calls still obey the cap above.
AP_READ_WORKERS=8

AP_REDIS_URL=redis://127.0.0.1:6379/0
# Finished model extractions only. The layout parser does not use this cache.
AP_CACHE_TTL_SECONDS=604800
